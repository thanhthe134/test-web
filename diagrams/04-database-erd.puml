@startuml SquareSnake_ERD
hide circle
skinparam linetype ortho
skinparam backgroundColor #0B0B0D
skinparam defaultFontName "Plus Jakarta Sans"
skinparam defaultFontColor #FFFFFF
skinparam entity {
  BackgroundColor #141417
  BorderColor #E5C148
  FontColor #FFFFFF
  AttributeFontColor #D4D4D8
}
skinparam arrow {
  Color #E5C148
  FontColor #E5C148
}

entity "categories" as categories {
  * **category_id** : INT <<PK, AUTO_INCREMENT>>
  --
  * category_name : VARCHAR(120) <<NOT NULL>>
  * slug : VARCHAR(120) <<UNIQUE, NOT NULL>>
  description : TEXT
  created_at : TIMESTAMP
}

entity "products" as products {
  * **product_id** : INT <<PK, AUTO_INCREMENT>>
  --
  * **category_id** : INT <<FK -> categories.category_id>>
  * product_name : VARCHAR(180) <<NOT NULL>>
  * model_code : VARCHAR(50) <<UNIQUE, NOT NULL>>
  short_description : TEXT
  * technical_specs : JSON <<NOT NULL>>
  image_url : VARCHAR(255)
  video_demo_url : VARCHAR(255)
  is_featured : BOOLEAN
  status : ENUM('available', 'maintenance')
  created_at : TIMESTAMP
}

entity "projects" as projects {
  * **project_id** : INT <<PK, AUTO_INCREMENT>>
  --
  * event_name : VARCHAR(200) <<NOT NULL>>
  * client_name : VARCHAR(160) <<NOT NULL>>
  * location : VARCHAR(180) <<NOT NULL>>
  * event_date : DATE <<NOT NULL>>
  * equipment_used : VARCHAR(255) <<NOT NULL>>
  summary : TEXT
  thumbnail_url : VARCHAR(255)
  created_at : TIMESTAMP
}

entity "contacts" as contacts {
  * **contact_id** : INT <<PK, AUTO_INCREMENT>>
  --
  * customer_name : VARCHAR(150) <<NOT NULL>>
  * phone : VARCHAR(30) <<NOT NULL>>
  email : VARCHAR(150)
  company_agency : VARCHAR(180)
  event_date : DATE
  * interested_categories : VARCHAR(255) <<NOT NULL>>
  stage_requirements : TEXT
  status : ENUM('pending', 'contacted', 'quoted')
  created_at : TIMESTAMP
}

categories ||--o{ products : "1 danh mục có nhiều thiết bị\n(ON DELETE RESTRICT, ON UPDATE CASCADE)"
@enduml
